# ============================================================
# portal-rag-assistant 凭证配置模板
# 复制为 .env 并填入真实值（本地运行）；Vercel 部署时在 Dashboard 配置同名变量。
# .env 已在 .gitignore 中，真实凭证严禁提交到代码仓库。
# ============================================================

# Qoder Cloud Agents 个人访问令牌（PAT），仅服务端使用，绝不能出现在前端
QODER_PAT=pt-your-personal-access-token

# Qoder Cloud Agents Identity ID
QODER_IDENTITY_ID=idn_your_identity_id

# 客服问答 Agent 的 Template ID
QODER_TEMPLATE_ID=tmpl_your_template_id

# 本地服务端口（可选，默认 8787）
PORT=8787
